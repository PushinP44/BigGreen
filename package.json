{
  "name": "big-green",
  "version": "0.1.0",
  "description": "Personal money tracker across platforms. Base currency HKD.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
