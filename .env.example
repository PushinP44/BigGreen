# Big Green — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must stay that way.
# Never put a service-role key in a NEXT_PUBLIC_* variable (PLAN §11).

# ── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Drizzle migrations) ───────────────────────────────────────────
# Supabase → Settings → Database → Connection string (use the pooler for the app,
# the direct connection for migrations).
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ── App ─────────────────────────────────────────────────────────────────────
# Every date bucket ("today", "this month", committed horizon) uses this zone.
# See PLAN.md D4 — do not set this to UTC.
APP_TIMEZONE=Asia/Hong_Kong
APP_BASE_CURRENCY=HKD
