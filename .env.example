# Big Green — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must stay that way.
# Never put a service-role key in a NEXT_PUBLIC_* variable (PLAN §11).

# ── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Drizzle migrations) ───────────────────────────────────────────
# Supabase → Settings → Database → Connection string (use the pooler for the app,
# the direct connection for migrations).
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ── App ─────────────────────────────────────────────────────────────────────
# Every date bucket ("today", "this month", committed horizon) uses this zone.
# See PLAN.md D4 — do not set this to UTC.
APP_TIMEZONE=Asia/Hong_Kong
APP_BASE_CURRENCY=HKD

# ── Email ingest ────────────────────────────────────────────────────────────
# Shared secret between the Gmail Apps Script and /api/ingest/email.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in the Apps Script under Project Settings → Script Properties
# → INGEST_SECRET. Unset, the endpoint refuses every request rather than
# accepting unsigned writes to a money ledger.
EMAIL_INGEST_SECRET=

# Which account emailed transactions are filed against. The ingest endpoint is
# called by a machine, so there is no session to read.
# NOT MULTI-USER: one secret writes to one account. A public build needs a
# per-user secret stored against the account and looked up before verification.
EMAIL_INGEST_USER_ID=
